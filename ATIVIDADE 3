#include <stdio.h>

int main() {
    int matriz[3][3];
    int i, j;

    for (i = 0; i < 3; i++) {
        for (j = 0; j < 3; j++) {
            printf("Digite um numero: ");
            scanf("%d", &matriz[i][j]);
        }
    }

    for (i = 0; i < 3; i++) {
        printf("%d - %d - %d\n")
               matriz[i][0],
               matriz[i][1],
               matriz[i][2]);
    }

    return 0;
}
